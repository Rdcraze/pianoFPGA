set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10F17C8
set_global_assignment -name TOP_LEVEL_ENTITY piano_phase0_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_PACKAGE FBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 256
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 8
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name SDC_FILE piano_phase0_top.sdc
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

set_global_assignment -name VERILOG_FILE ../../rtl/audio/phase0_body_filter.v
set_global_assignment -name VERILOG_FILE ../../rtl/audio/phase0_audio_path.v
set_global_assignment -name VERILOG_FILE ../../rtl/audio/phase0_sample_gen.v
set_global_assignment -name VERILOG_FILE ../../rtl/audio/phase1_reduced_voice.v
set_global_assignment -name VERILOG_FILE ../../rtl/control/phase0_fixed_control.v
set_global_assignment -name VERILOG_FILE ../../rtl/peripherals/phase0_reset_sync.v
set_global_assignment -name VERILOG_FILE ../../rtl/peripherals/phase0_audio_mclk_pll.v
set_global_assignment -name VERILOG_FILE ../../rtl/peripherals/uart_tx.v
set_global_assignment -name VERILOG_FILE ../../rtl/peripherals/wm8978_boot_seq.v
set_global_assignment -name VERILOG_FILE ../../rtl/peripherals/wm8978_codec_stub.v
set_global_assignment -name VERILOG_FILE ../../rtl/peripherals/wm8978_dac_tx.v
set_global_assignment -name VERILOG_FILE ../../rtl/peripherals/wm8978_i2c_ctrl.v
set_global_assignment -name VERILOG_FILE ../../rtl/top/piano_phase0_top.v

set_location_assignment PIN_E1 -to sys_clk_50m
set_location_assignment PIN_M15 -to sys_rst_n
set_location_assignment PIN_D12 -to audio_bclk
set_location_assignment PIN_E9 -to audio_lrc
set_location_assignment PIN_C14 -to audio_adcdat
set_location_assignment PIN_N6 -to uart1_rx
set_location_assignment PIN_D14 -to audio_mclk
set_location_assignment PIN_D11 -to audio_dacdat
set_location_assignment PIN_P15 -to i2c_scl
set_location_assignment PIN_N14 -to i2c_sda
set_location_assignment PIN_N5 -to uart1_tx

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
